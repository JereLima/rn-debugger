{
  "name": "rn-debugger",
  "version": "0.1.1",
  "description": "Zero-config debugger for React Native & Expo — console, network, state, storage (AsyncStorage/MMKV/Firestore) and React DevTools in one desktop app",
  "keywords": ["react-native", "expo", "debugger", "debug", "devtools", "react-devtools", "redux", "zustand", "async-storage", "mmkv", "firestore", "desktop"],
  "license": "MIT",
  "author": "Jeremias Santos Lima <jeremiaslimag12@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/JereLima/rn-debugger.git", "directory": "sdk" },
  "bugs": { "url": "https://github.com/JereLima/rn-debugger/issues" },
  "homepage": "https://github.com/JereLima/rn-debugger#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" },
    "./expo": { "types": "./dist/expo.d.ts", "import": "./dist/expo.mjs", "require": "./dist/expo.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "example:sync": "cd ../example && npm install ../sdk"
  },
  "peerDependencies": {
    "expo-constants": "*",
    "@react-native-async-storage/async-storage": "*",
    "react-native-mmkv": "*"
  },
  "peerDependenciesMeta": {
    "expo-constants": { "optional": true },
    "@react-native-async-storage/async-storage": { "optional": true },
    "react-native-mmkv": { "optional": true }
  },
  "devDependencies": { "tsup": "^8", "typescript": "^5", "@types/react-native": "*" }
}
